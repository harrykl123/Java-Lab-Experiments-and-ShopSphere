<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>Admin dashboard | ShopSphere Motors</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head>
<body><header class="site-header"><a class="brand" href="index.jsp">ShopSphere<span>Motors</span></a><nav><a href="cars">View site</a><a href="home.jsp">Dashboard</a><a href="logout">Logout</a></nav></header>
<main class="page-wrap"><div class="page-title"><p class="eyebrow">INVENTORY CONTROL</p><h1>Admin dashboard.</h1><p>Add cars and manage booking requests. Only users with the ADMIN role can access this page.</p>
<c:if test="${param.success == 'true'}"><div class="notice success">Action completed successfully.</div></c:if><c:if test="${not empty param.error}"><div class="notice error">Please check the values and try again.</div></c:if></div>
<section class="admin-panel"><h2>Add a car</h2><form action="admin" method="post" class="admin-form"><input type="hidden" name="action" value="addCar">
<label>Car name<input name="name" required maxlength="150"></label><label>Category<select name="categoryId" required><c:forEach var="cat" items="${categories}"><option value="${cat[0]}"><c:out value="${cat[1]}"/></option></c:forEach></select></label>
<label>Price (₹)<input type="number" name="price" min="0" step="0.01" required></label><label>Stock<input type="number" name="stock" min="0" required value="1"></label>
<label>SKU (unique)<input name="sku" required maxlength="100"></label><label>Image URL<input name="image" maxlength="500" placeholder="https://..."></label>
<label class="full-field">Description<textarea name="description" rows="2"></textarea></label><button class="button" type="submit">Add car</button></form></section>
<section class="admin-panel"><h2>Car inventory</h2><div class="table-wrap"><table><thead><tr><th>Car</th><th>Category</th><th>SKU</th><th>Price</th><th>Stock</th><th>Action</th></tr></thead><tbody><c:forEach var="car" items="${cars}"><tr><td><c:out value="${car.name}"/></td><td><c:out value="${car.categoryName}"/></td><td><c:out value="${car.sku}"/></td><td>₹ <c:out value="${car.price}"/></td><td><c:out value="${car.stock}"/></td><td><form action="admin" method="post" onsubmit="return confirm('Delete this car?')"><input type="hidden" name="action" value="deleteCar"><input type="hidden" name="carId" value="${car.id}"><button class="button button-small button-danger" type="submit">Delete</button></form></td></tr></c:forEach></tbody></table></div></section>
<section class="admin-panel"><h2>Booking requests</h2><div class="table-wrap"><table><thead><tr><th>Request</th><th>Car</th><th>Date</th><th>Message</th><th>Status</th><th>Update status</th></tr></thead><tbody><c:forEach var="booking" items="${bookings}"><tr><td>#<c:out value="${booking.id}"/></td><td><c:out value="${booking.carName}"/></td><td><c:out value="${booking.preferredDate}"/></td><td><c:out value="${booking.message}"/></td><td><c:out value="${booking.status}"/></td><td><form action="admin" method="post" class="inline-form"><input type="hidden" name="action" value="updateBooking"><input type="hidden" name="bookingId" value="${booking.id}"><select name="status"><option>PENDING</option><option>CONFIRMED</option><option>CANCELLED</option><option>COMPLETED</option></select><button class="button button-small" type="submit">Save</button></form></td></tr></c:forEach></tbody></table></div></section>
</main><footer class="footer">© 2026 ShopSphere Motors · Admin</footer></body></html>
