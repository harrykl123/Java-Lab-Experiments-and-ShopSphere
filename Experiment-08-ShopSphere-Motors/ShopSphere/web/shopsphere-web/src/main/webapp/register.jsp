<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Create account | ShopSphere Motors</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/style.css"></head>
<body class="auth-page"><a class="brand auth-brand" href="index.jsp">ShopSphere<span>Motors</span></a><main class="auth-card"><p class="eyebrow">JOIN THE JOURNEY</p><h1>Create account.</h1><p class="muted">Save favourites and manage booking requests.</p>
<% if ("true".equals(request.getParameter("error"))) { %><div class="notice error">Registration failed. Check your details or try another email.</div><% } %>
<form action="register" method="post" class="stack-form"><label>Full name<input type="text" name="name" autocomplete="name" required maxlength="100"></label><label>Email address<input type="email" name="email" autocomplete="email" required maxlength="150"></label><label>Phone number<input type="tel" name="phone" autocomplete="tel" maxlength="20"></label><label>Password<input type="password" name="password" autocomplete="new-password" required minlength="6"></label><button class="button button-wide" type="submit">Create account</button></form>
<p class="auth-foot">Already registered? <a href="login.jsp">Sign in</a></p><a class="back-link" href="index.jsp">← Back to home</a></main></body></html>
